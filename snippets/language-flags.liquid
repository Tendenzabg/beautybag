{%- doc -%}
  Renders a language menu with flags: a button showing the current flag opens a list with one entry per
  available language. Each entry submits the localization form, so switching works without JavaScript
  (the menu itself is a native details element; JavaScript only closes it on outside click and Escape).

  @param {string} form_id - The block or section ID, used to keep generated IDs unique
  @param {string} localization_style - Where the menu is rendered ('dropdown' in the header or 'drawer')
  @param {string} [form_style] - The style string applied to the wrapper
  @param {string} [back] - The URL to redirect to after form submission

  @example
  {% render 'language-flags', form_id: section.id, localization_style: 'dropdown', form_style: form_style %}
{%- enddoc -%}

{%- liquid
  assign flag_id_suffix = form_id | append: '-' | append: localization_style
  assign flag_form_id = 'LanguageFlagsForm-' | append: flag_id_suffix
  assign flag_form_label = 'content.language' | t
  assign current_language = localization.language
  assign current_suffix = flag_id_suffix | append: '-current'
-%}
<language-flags-component
  class="language-flags language-flags--{{ localization_style }}"
  style="{{ form_style }}"
>
  <details
    class="language-flags__details"
    ref="details"
  >
    <summary
      class="language-flags__summary"
      ref="summary"
      aria-label="{{ flag_form_label | escape }}: {{ current_language.endonym_name | capitalize | escape }}"
    >
      <span class="language-flags__flag">
        {%- render 'language-flag-icon', iso_code: current_language.iso_code, id_suffix: current_suffix -%}
      </span>
      <span class="language-flags__code">{{ current_language.iso_code | upcase }}</span>
      <span class="svg-wrapper icon-caret language-flags__caret">
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="language-flags__panel color-custom-popover">
      {%- form 'localization',
        id: flag_form_id,
        class: 'language-flags__form',
        return_to: back,
        aria-label: flag_form_label
      -%}
        <ul
          class="language-flags__list list-unstyled"
          role="list"
        >
          {%- for language in localization.available_languages -%}
            {%- assign item_suffix = flag_id_suffix | append: '-' | append: language.iso_code -%}
            <li class="language-flags__item">
              <button
                type="submit"
                name="language_code"
                value="{{ language.iso_code }}"
                class="language-flags__button"
                lang="{{ language.iso_code }}"
                {% if language.iso_code == current_language.iso_code %}
                  aria-current="true"
                {% endif %}
              >
                <span class="language-flags__flag">
                  {%- render 'language-flag-icon', iso_code: language.iso_code, id_suffix: item_suffix -%}
                </span>
                <span class="language-flags__name">{{ language.endonym_name | capitalize }}</span>
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endform -%}
    </div>
  </details>
</language-flags-component>

{% stylesheet %}
  .language-flags {
    --language-flags-flag-width: 1.5rem;
    --language-flags-flag-radius: 3px;

    display: block;
    position: relative;
    min-width: 0;
  }

  .language-flags__details {
    position: relative;
  }

  .language-flags__summary {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    min-height: 2rem;
    padding-block: var(--padding-3xs);
    padding-inline: var(--padding-xs);
    border-radius: var(--language-flags-flag-radius);
    color: var(--color-foreground);
    font-family: var(--menu-localization-font, inherit);
    font-size: var(--menu-localization-font-size, var(--font-size--sm));
    line-height: 1;
    cursor: pointer;
    list-style: none;
  }

  .language-flags__summary::-webkit-details-marker {
    display: none;
  }

  .language-flags__summary:focus-visible,
  .language-flags__button:focus-visible {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: 2px;
  }

  .language-flags__caret {
    display: flex;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    color: var(--color-foreground);
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .language-flags__details[open] .language-flags__caret {
    transform: rotate(180deg);
  }

  .language-flags__flag {
    display: inline-flex;
    width: var(--language-flags-flag-width);
    aspect-ratio: 3 / 2;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: var(--language-flags-flag-radius);
    box-shadow: 0 0 0 1px rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .language-flags__flag svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .language-flags__code-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    font-size: 0.625rem;
    font-weight: 600;
  }

  .language-flags__code {
    letter-spacing: 0.04em;
  }

  .language-flags__panel {
    position: absolute;
    inset-block-start: calc(100% + var(--gap-2xs));
    inset-inline-end: 0;
    z-index: var(--layer-header-menu);
    min-width: max-content;
    padding: var(--padding-xs);
    border: var(--style-border-width) solid var(--color-border);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 4px 16px rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .language-flags__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
    margin: 0;
    padding: 0;
  }

  .language-flags__button {
    display: flex;
    align-items: center;
    gap: var(--gap-xs);
    width: 100%;
    min-height: 2.5rem;
    padding: var(--padding-xs) var(--padding-sm);
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--menu-localization-font, inherit);
    font-size: var(--menu-localization-font-size, var(--font-size--sm));
    text-align: start;
    cursor: pointer;
  }

  .language-flags__button:hover {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-8));
  }

  .language-flags__button[aria-current='true'] {
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-10));
    font-weight: 500;
  }

  /* In the mobile drawer the list opens in the page flow instead of floating */
  .language-flags--drawer {
    padding: var(--padding-md) var(--padding-lg);
  }

  .language-flags--drawer .language-flags__panel {
    position: static;
    margin-block-start: var(--gap-2xs);
    box-shadow: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .language-flags__caret {
      transition: none;
    }
  }
{% endstylesheet %}
