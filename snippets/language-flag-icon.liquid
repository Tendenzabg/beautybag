{%- doc -%}
  Renders the flag of a language as an inline SVG (decorative), or its upper-case code when no flag is drawn.

  @param {string} iso_code - The language ISO code (for example 'bg' or 'en')
  @param {string} id_suffix - A unique suffix for generated SVG IDs

  @example
  {% render 'language-flag-icon', iso_code: language.iso_code, id_suffix: 'header-en' %}
{%- enddoc -%}

{%- case iso_code -%}
  {%- when 'bg' -%}
    <svg viewBox="0 0 30 20" focusable="false" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><rect y="6.67" width="30" height="6.67" fill="#00966E"/><rect y="13.33" width="30" height="6.67" fill="#D62612"/></svg>
  {%- when 'en' -%}
    <svg viewBox="0 0 60 40" preserveAspectRatio="xMidYMid slice" focusable="false" aria-hidden="true">
      <clipPath id="uk-s-{{ id_suffix }}"><path d="M0,0 v40 h60 v-40 z"/></clipPath>
      <clipPath id="uk-t-{{ id_suffix }}"><path d="M30,20 h30 v20 z v20 h-30 z h-30 v-20 z v-20 h30 z"/></clipPath>
      <g clip-path="url(#uk-s-{{ id_suffix }})">
        <path d="M0,0 v40 h60 v-40 z" fill="#012169"/>
        <path d="M0,0 L60,40 M60,0 L0,40" stroke="#fff" stroke-width="8"/>
        <path d="M0,0 L60,40 M60,0 L0,40" clip-path="url(#uk-t-{{ id_suffix }})" stroke="#C8102E" stroke-width="5"/>
        <path d="M30,0 v40 M0,20 h60" stroke="#fff" stroke-width="13"/>
        <path d="M30,0 v40 M0,20 h60" stroke="#C8102E" stroke-width="8"/>
      </g>
    </svg>
  {%- when 'it' -%}
    <svg viewBox="0 0 30 20" focusable="false" aria-hidden="true"><rect width="10" height="20" fill="#009246"/><rect x="10" width="10" height="20" fill="#fff"/><rect x="20" width="10" height="20" fill="#CE2B37"/></svg>
  {%- when 'de' -%}
    <svg viewBox="0 0 30 20" focusable="false" aria-hidden="true"><rect width="30" height="6.67" fill="#000"/><rect y="6.67" width="30" height="6.67" fill="#DD0000"/><rect y="13.33" width="30" height="6.67" fill="#FFCE00"/></svg>
  {%- when 'ro' -%}
    <svg viewBox="0 0 30 20" focusable="false" aria-hidden="true"><rect width="10" height="20" fill="#002B7F"/><rect x="10" width="10" height="20" fill="#FCD116"/><rect x="20" width="10" height="20" fill="#CE1126"/></svg>
  {%- else -%}
    <span class="language-flags__code-fallback">{{ iso_code | upcase }}</span>
{%- endcase -%}
