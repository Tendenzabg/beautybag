{%- doc -%}
  Renders the hover panel of a collection product card: format pills (e.g. 30 ml / 70 ml, from the
  linked product in the `other_format` metafield) and a "Buy now" button that adds the chosen
  variant to the cart and goes straight to checkout. Works without JavaScript (radio inputs + form).
  Two layouts: 'overlay' (over the card image, only on hover-capable devices) and 'inline' (below the
  price, only on touch devices). Hidden when nothing can be bought.

  @param {object} product - The product object of the card
  @param {string} [layout] - 'overlay' (default) or 'inline'

  @example
  {% render 'product-card-formats', product: product, layout: 'inline' %}
{%- enddoc -%}

{%- liquid
  assign bb_layout = layout | default: 'overlay'
  assign bb_cur_variant = product.selected_or_first_available_variant
  assign bb_cur_ml = product.metafields.custom.size_ml.value | plus: 0
  assign bb_can_buy = product.available

  assign bb_other = product.metafields.custom.other_format.value
  assign bb_comp = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value
-%}

{%- liquid
  assign bb_keyed = ''
  assign bb_ids = product.id | append: ','

  # 1. current product
  assign bb_key = bb_cur_ml | prepend: '0000' | slice: -4, 4
  capture bb_html
    render 'product-card-format-pill', item: product, ml: bb_cur_ml, checked: product.available
  endcapture
  assign bb_keyed = bb_key | append: '§§' | append: bb_html
  assign bb_checked_done = product.available

  # 2. linked format
  if bb_other != blank
    assign bb_ids = bb_ids | append: bb_other.id | append: ','
    assign bb_ml = bb_other.metafields.custom.size_ml.value | plus: 0
    assign bb_key = bb_ml | prepend: '0000' | slice: -4, 4
    assign bb_do_check = false
    if bb_other.available and bb_checked_done == false
      assign bb_do_check = true
      assign bb_checked_done = true
    endif
    capture bb_html
      render 'product-card-format-pill', item: bb_other, ml: bb_ml, checked: bb_do_check
    endcapture
    assign bb_keyed = bb_keyed | append: '‖‖' | append: bb_key | append: '§§' | append: bb_html
    if bb_other.available
      assign bb_can_buy = true
    endif
  endif

  # Second level: format linked to the linked one (15 ml -> 70 ml -> 30 ml)
  if bb_other != blank
    assign bb_other2 = bb_other.metafields.custom.other_format.value
    assign bb_o2_id = bb_other2.id | append: ','
    assign bb_o2_new = false
    if bb_other2 != blank
      unless bb_ids contains bb_o2_id
        assign bb_o2_new = true
      endunless
    endif
    if bb_o2_new
      assign bb_ids = bb_ids | append: bb_o2_id
      assign bb_ml = bb_other2.metafields.custom.size_ml.value | plus: 0
      assign bb_key = bb_ml | prepend: '0000' | slice: -4, 4
      assign bb_do_check = false
      if bb_other2.available and bb_checked_done == false
        assign bb_do_check = true
        assign bb_checked_done = true
      endif
      capture bb_html
        render 'product-card-format-pill', item: bb_other2, ml: bb_ml, checked: bb_do_check
      endcapture
      assign bb_keyed = bb_keyed | append: '‖‖' | append: bb_key | append: '§§' | append: bb_html
      if bb_other2.available
        assign bb_can_buy = true
      endif
    endif
    assign bb_comp_other = bb_other.metafields['shopify--discovery--product_recommendation'].complementary_products.value
    if bb_comp_other != blank
      if bb_comp != blank
        assign bb_comp = bb_comp | concat: bb_comp_other
      else
        assign bb_comp = bb_comp_other
      endif
    endif
  endif

  # 3. 15 ml refill (published products only)
  for bb_c in bb_comp
    assign bb_c_id = bb_c.id | append: ','
    if bb_ids contains bb_c_id
      continue
    endif
    if bb_c.metafields.custom.is_refill.value and bb_c.metafields.custom.size_ml.value == 15
      assign bb_ids = bb_ids | append: bb_c_id
      assign bb_do_check = false
      if bb_c.available and bb_checked_done == false
        assign bb_do_check = true
        assign bb_checked_done = true
      endif
      capture bb_html
        render 'product-card-format-pill', item: bb_c, ml: 15, checked: bb_do_check
      endcapture
      assign bb_keyed = bb_keyed | append: '‖‖0015§§' | append: bb_html
      if bb_c.available
        assign bb_can_buy = true
      endif
    endif
  endfor

  assign bb_sorted = bb_keyed | split: '‖‖' | sort
-%}

{%- if bb_can_buy and product.id != blank -%}
  <div class="bb-cardbuy bb-cardbuy--{{ bb_layout }}">
    <form
      action="{{ routes.cart_add_url }}"
      method="post"
      class="bb-cardbuy__form"
    >
      <input type="hidden" name="return_to" value="/checkout">
      <input type="hidden" name="quantity" value="1">

      {%- if bb_sorted.size > 1 -%}
        <fieldset class="bb-cardbuy__sizes">
          <legend class="visually-hidden">{{ 'content.product_card_format' | t }}</legend>
          {%- for bb_entry in bb_sorted -%}
            {{- bb_entry | split: '§§' | last -}}
          {%- endfor -%}
        </fieldset>
      {%- else -%}
        <input type="hidden" name="id" value="{{ bb_cur_variant.id }}">
      {%- endif -%}

      <button type="submit" class="bb-cardbuy__buy">
        {{- 'content.product_card_buy_now' | t -}}
      </button>
    </form>
  </div>
{%- endif -%}

{% stylesheet %}
  .bb-cardbuy {
    --bb-cardbuy-radius: var(--style-border-radius-buttons-primary, 100px);

    display: none;
  }

  /* Overlay on the image: only on devices with hover. */
  .bb-cardbuy--overlay {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: var(--layer-raised);
    padding: var(--padding-sm);
    pointer-events: none;
  }

  @media (hover: hover) {
    .bb-cardbuy--overlay {
      display: block;
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity var(--animation-speed-slow) var(--animation-easing),
        transform var(--animation-speed-slow) var(--animation-easing);
    }

    product-card:is(:hover, :focus-within) .bb-cardbuy--overlay {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }

  /* Below the price: touch devices, where there is no hover. */
  @media (hover: none) {
    .bb-cardbuy--inline {
      display: block;
      position: relative;
      z-index: var(--layer-raised);
      padding-block-start: var(--padding-xs, 0.5rem);
    }

    .bb-cardbuy--inline .bb-cardbuy__form {
      padding: 0;
      background: none;
      backdrop-filter: none;
    }

    .bb-cardbuy--inline .bb-cardbuy__sizes {
      justify-content: flex-start;
    }

    .bb-cardbuy--inline .bb-cardbuy__size span {
      min-width: 0;
      padding: 0.4rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bb-cardbuy {
      transition: none;
      transform: none;
    }
  }

  .bb-cardbuy__form {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    border-radius: min(var(--bb-cardbuy-radius), 20px);
    background: color-mix(in srgb, var(--color-background) 94%, transparent);
    backdrop-filter: blur(6px);
  }

  .bb-cardbuy__sizes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .bb-cardbuy__size {
    position: relative;
    display: inline-flex;
    min-width: 0;
  }

  .bb-cardbuy__size input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .bb-cardbuy__size span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-border, currentcolor);
    border-radius: var(--bb-cardbuy-radius);
    color: var(--color-foreground);
    font-size: 0.875rem;
    line-height: 1.2;
    white-space: nowrap;
  }

  .bb-cardbuy__size input:checked + span {
    border-color: var(--color-primary-button-background);
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .bb-cardbuy__size input:focus-visible + span {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .bb-cardbuy__size input:disabled {
    cursor: not-allowed;
  }

  .bb-cardbuy__size input:disabled + span {
    opacity: 0.4;
    text-decoration: line-through;
  }

  .bb-cardbuy__buy {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-foreground);
    border-radius: var(--bb-cardbuy-radius);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--animation-speed-slow) var(--animation-easing),
      color var(--animation-speed-slow) var(--animation-easing);
  }

  @media (hover: hover) {
    .bb-cardbuy__buy:hover {
      background: var(--color-primary-button-background);
      border-color: var(--color-primary-button-background);
      color: var(--color-primary-button-text);
    }
  }

  .bb-cardbuy__buy:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
{% endstylesheet %}
